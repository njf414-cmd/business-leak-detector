# ======================================
# Business Leak Detector
# Production environment template
# ======================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Cron authentication
CRON_SECRET=

# Core features
FEATURE_ANALYSIS=true
FEATURE_RECURRING_SCANS=true
FEATURE_CUSTOMER_NOTIFICATIONS=true

# Optional / future features
FEATURE_AI_ANALYSIS=false
FEATURE_AUTOMATED_RECOVERY=false
FEATURE_AI_SETUP=false
FEATURE_DFY_SETUP=false
FEATURE_EXPERIMENTAL_DETECTORS=false

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Business Leak Detector <reports@yourdomain.com>

# Public production URL
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Limits
MAX_UPLOAD_MB=10
MAX_ANALYSIS_ROWS=10000

# Maintenance
MAINTENANCE_MODE=false
