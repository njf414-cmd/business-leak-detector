{
  "functions": {
    "app/api/queue/analysis-jobs/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "analysis-jobs",
          "retryAfterSeconds": 30,
          "initialDelaySeconds": 0
        }
      ]
    },
    "app/api/queue/notification-deliveries/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "notification-deliveries",
          "retryAfterSeconds": 30,
          "initialDelaySeconds": 0
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/recurring-scans",
      "schedule": "0 12 * * *"
    }
  ]
}
