/* ================================== */
/* REGISTER CATALOG */
/* ================================== */

export function registerDetectorCatalog():
  void {
  for (
    const detector of detectorCatalog
  ) {
    if (
      hasDetector(
        detector.id
      )
    ) {
      continue;
    }

    registerDetector(
      detector
    );
  }
}

/* ================================== */
/* GET CATALOG */
/* ================================== */

export function getDetectorCatalog():
  BusinessLeakDetector[] {
  return [
    ...detectorCatalog,
  ];
}

/* ================================== */
/* CATALOG INFORMATION */
/* ================================== */

export function getDetectorCatalogStats() {
  const universal =
    detectorCatalog.filter(
      (detector) =>
        detector.scope ===
        "universal"
    ).length;

  const industry =
    detectorCatalog.filter(
      (detector) =>
        detector.scope ===
        "industry"
    ).length;

  return {
    total:
      detectorCatalog.length,

    universal,

    industry,
  };
}